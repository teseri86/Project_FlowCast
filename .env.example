API_USGS_PAT=enter your usgs token here
AWS_ACCESS_KEY_ID=your aws access key id here
AWS_SECRET_ACCESS_KEY=your aws secret access key here
AWS_DEFAULT_REGION=us-east-1
S3_BUCKET_NAME=flowcast-raw-data
# Optional: read/write the local data/ folder instead of S3 (default is s3)
# FLOWCAST_DATA_SOURCE=local

# Be sure to replace all placeholder values with your actual credentials.
# Save as .env at the root of the project folder.
# Do not include any sensitive information or credentials elsewhere in the project files.
# Weather comes from Open-Meteo, which needs no key for non-commercial use.